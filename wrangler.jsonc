{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ATENÇÃO: este nome precisa ser IDÊNTICO ao do Worker criado no painel da
  // Cloudflare (Workers & Pages → nome no topo). O `wrangler deploy` publica
  // para o nome que está aqui, não para o Worker que o painel conectou — se
  // divergirem, nasce um segundo Worker e o conectado fica vazio.
  "name": "portfolio",
  "compatibility_date": "2026-09-22",

  // Cada versão enviada por push na `dev` ganha uma URL própria para revisão,
  // isolada do tráfego de produção. É o ambiente de homologação: sem isso, o
  // build de preview sobe a versão mas não há onde olhar o resultado.
  "preview_urls": true,

  // Logs de EXECUÇÃO do Worker (requisições ao site publicado), visíveis em
  // Workers & Pages → portfolio → Logs. Não tem relação com o log do build:
  // falha de Workers Builds aparece no próprio build, independente disto.
  // `persist` não é campo válido — a configuração aceita só `enabled`,
  // `head_sampling_rate` e `logs.invocation_logs`.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true
    }
  },

  // Site 100% pré-renderizado: não há Worker script (nenhum `main`), só os
  // arquivos estáticos que o build gera. Se um dia precisar de rota dinâmica,
  // aí sim entra `main` + binding ASSETS.
  "assets": {
    "directory": "./dist/client",
    // Caminho desconhecido devolve 404 de verdade com a public/404.html.
    // "single-page-application" devolveria 200 com o index — soft 404, ruim
    // para busca, e sem ganho aqui porque só existe uma rota.
    "not_found_handling": "404-page"
  }
}
